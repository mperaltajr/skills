# ── Claude Code local settings (machine-specific, never share) ──
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/

# ── Client / project-specific files (never commit these) ──
# Template configs live in the client's Claude Project folder, not in the skill.
# Run: setup_template.py <pptx> <name> --output "<Claude Projects\Client>"
slide-builder/clients/
*.pptx
*.docx
*.xlsx
*.pdf
*.png
*.jpg
*.jpeg

# ── Twin PPTX corpus — the curated, hand-built single-slide reference files
# in slide-builder/_renders/twins/ DO ship. They're tiny (~12 MB across
# ~430 files) and the composer needs them to produce output. Render-time
# artifacts (PNG caches, _pngs_themed, *_render folders) stay ignored.
!slide-builder/_renders/twins/*.pptx
# Render caches inside the twins dir stay ignored regardless.
slide-builder/_renders/twins/_pngs_themed/
slide-builder/_renders/twins/*_render/
slide-builder/_renders/twins/_pngs/

# Reference PPTX templates (used by smoke_test.py + as design exemplars) ship too.
!references/PPT Files/*.pptx

# ── Slide Lab anti-exemplar PNGs — the 9 ported Tier-1 failure-mode images
# ship as part of the visual reference library. Each `reference/anti-patterns/
# <slug>/exemplar.png` pairs with a `WHY.md`. Without the PNG the library
# is text-only. ~30 KB each, 9 files total. Override the *.png rule above.
!slide-builder/reference/anti-patterns/*/exemplar.png

# Icon-helper work artifacts from a parallel chat — audit screenshots and
# backups of pre-fix icon XML. Not load-bearing for the skill.
slide-builder/icons/_audit/
slide-builder/icons/_backup/

# Per-build runtime lock from scheduled-tasks tooling — not part of the skill.
.claude/scheduled_tasks.lock

# ── Session working files ──
_session/
_versions/
_reference/
_screenshots/
_smoke_out/
*-chart-data.xlsx

# ── Python ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── OS clutter ──
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ──
.vscode/
*.swp

# ── Standalone onboarding deliverables (personal, distributed by hand) ──
Slide-Lab-Tutorial.html
Slide-Lab-Install-Guide.docx
Slide-Lab-Example-Registration.html
Slide-Lab-Example-Review.html
Slide-Lab-Example-Storyline.html
Slide-Lab-Example-Deck.pptx

# Personal, engagement-specific skill (not part of the shared repo)
financial-session-deck/
