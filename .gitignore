# ── Allow list: only the folders and files below are published ──
# Everything at the top level is ignored first, then the published Slide Lab
# folders and root files are let back in one by one. Anything else someone
# keeps in this folder (other skills, notes, scratch files) stays private by
# default; never add its name here.
/*
!/.gitignore
!/.github/
!/slide-builder/
!/slide-lab/
!/slide-qc/
!/storyline-helper/
!/rfp-helper/
!/slidelab-log/
!/docs/
!/README.md
!/SECURITY.md
!/LICENSE
!/requirements.txt
!/Slide-Lab-Example-Deck.pptx
!/Slide-Lab-Example-Review.html
!/Slide-Lab-Example-Storyline.html
!/Slide-Lab-Tutorial.html
!/Slide-Lab-Install-Guide.docx

# ── Claude Code local settings (machine-specific, never share) ──
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# ── Client / project-specific files (never commit these) ──
# Template configs live in the client's Claude Project folder, not in the skill.
slide-builder/clients/
*.pptx
*.docx
*.xlsx
*.pdf
*.png
*.jpg
*.jpeg

# ── Slide Lab anti-exemplar PNGs: the 9 failure-mode images ship as part of
# the visual reference library. Each `reference/anti-patterns/<slug>/
# exemplar.png` pairs with a `WHY.md`. Override the *.png rule above.
!slide-builder/reference/anti-patterns/*/exemplar.png

# Icon-helper work artifacts: audit screenshots and backups of pre-fix icon
# XML. Not load-bearing for the skill.
slide-builder/icons/_audit/
slide-builder/icons/_backup/

# ── Session working files ──
_session/
_versions/
_reference/
_screenshots/
_smoke_out/
*-chart-data.xlsx

# ── Python ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── OS clutter ──
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ──
.vscode/
*.swp

# Onboarding files (tutorial, install guide, examples) are tracked so every
# install gets current copies; the examples are regenerated with
# slide-builder/examples/showcase/make_showcase.py, never hand-edited.
!/Slide-Lab-Example-Deck.pptx
!/Slide-Lab-Install-Guide.docx
!docs/tutorial/*.png

# Never publish: internal decision notes (they name client work).
slide-builder/_decisions/
storyline-helper/_decisions/

# Owner-only tools (the converter check and a token measurement). They need
# the owner's own session folders, so they stay on the owner's computer.
slide-builder/tests/translate_replay.py
slide-builder/tests/translate_gonogo.py
slide-builder/tests/translate_alarm_calibrate.py
slide-builder/tests/translate_alarm_seeded.py
slide-builder/scripts/measure_page_tokens.py

# One computer's own Slide Lab choices (for example three designs per slide); never published
slide-builder/settings.local.json
